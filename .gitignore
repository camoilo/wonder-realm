# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（uv 按 .python-version 自动创建，不入库）
.venv/
venv/
env/

# 构建与缓存（**只忽略根目录**的产物：electron-builder 的资源目录 desktop/build/ 要入库）
/build/
/dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 运行时数据 ----------
# SQLite 数据库：角色、会话、消息、记忆、模型选择都在这里，属于本机数据
data/
*.db
*.db-wal
*.db-shm
*.db-journal

# 自动备份：同样是本机数据，不该进版本库
backups/

# 测试在工作区里临时建的库与目录（正常跑完会自己删掉，中途失败时别把工作区弄脏）
.test_*/

# ---------- 前端 ----------
# npm 依赖与缓存：依赖由 frontend/package.json + package-lock.json 锁定，装出来不入库。
# 注意 app/static/ 下的构建产物**要提交**（见 docs/DEVELOPMENT.md 8.1）：没装 Node 也能直接跑。
frontend/node_modules/
.npm-cache/

# ---------- 桌面端（Electron 外壳，见 docs/DEVELOPMENT.md 3.3） ----------
# electron 运行时 200MB+，按 desktop/package.json + package-lock.json 装出来即可，不入库。
# 下载慢时用镜像：ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm install --prefix desktop
desktop/node_modules/

# ---------- 配置与密钥 ----------
# 本地覆盖用的配置与密钥不入库；config.yaml 本身是仓库的一部分，保留
.env
.env.*
*.local.yaml

# ---------- 日志 ----------
*.log
logs/

# ---------- 编辑器与操作系统 ----------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 说明 ----------
# .python-version / uv.lock / pyproject.toml / config.yaml 都应当提交：
# 前者固定 Python 版本，uv.lock 锁定依赖版本，config.yaml 是运行配置模板。
